{
  "version": 1,
  "palette": {
    "background": "#1A0F2E",
    "background_lift": "#2A1B45",
    "primary": "#601FB7",
    "highlight": "#7C4DFF",
    "soft": "#B39DDB",
    "text": "#F3EEFF",
    "accent_gold": "#F5C542",
    "warning": "#FF6B6B"
  },
  "palette_rules": {
    "max_gold_elements_per_frame": 1,
    "warning_only_for": ["context_rot", "broken_edge", "forgetting"]
  },
  "canvases": {
    "vertical": {"w": 1080, "h": 1920, "platforms": ["instagram", "tiktok"]},
    "horizontal": {"w": 1920, "h": 1080, "platforms": ["linkedin", "youtube"]}
  },
  "type": {
    "font": "Inter",
    "vertical": {"headline": 96, "body": 56, "caption": 40},
    "horizontal": {"headline": 80, "body": 44, "caption": 32},
    "max_headline_lines": 2,
    "max_body_lines": 3,
    "max_words_on_screen": 12
  },
  "layout": {
    "outer_margin_pct_of_short_edge": 0.08,
    "vertical_safe_top_px": 250,
    "vertical_safe_bottom_px": 400,
    "spacing_unit_px": 24,
    "min_gap_px": 48,
    "alignment": ["left", "center"]
  },
  "motion": {
    "fps": 30,
    "scene_seconds": {"min": 3, "max": 6},
    "text_hold_seconds_min": 2.5,
    "transition_ms": 300,
    "easing": "ease-out",
    "text_entry": {"rise_px": 20, "ms": 400, "one_line_at_a_time": true},
    "dandy_man_enters_from": "left",
    "edge_draw_ms": 600,
    "context_rot_ms": 800
  },
  "copy_rules": {
    "banned_characters": ["—", "–"],
    "banned_phrases": ["project management tool", "jira", "asana", "agent harness", "framework", "revolutionary", "game-changing", "10x"],
    "required_end_card": "motifs/end-card.svg",
    "end_card_lines": ["dandylabs.dev", "14-day free trial"]
  }
}
