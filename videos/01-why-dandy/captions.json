 "cues": [
  {
   "start": 0.82,
   "end": 1.86,
   "text": "A builder and his agent"
  },
  {
   "start": 1.86,
   "end": 3.11,
   "text": "have a great night."
  },
  {
   "start": 3.11,
   "end": 3.79,
   "text": "Schema, decisions,"
  },
  {
   "start": 3.79,
   "end": 5.16,
   "text": "half the thing built."
  },
  {
   "start": 5.81,
   "end": 7.56,
   "text": "Next morning, new session."
  },
  {
   "start": 7.56,
   "end": 9.3,
   "text": "The agent remembers none of it."
  },
  {
   "start": 9.3,
   "end": 10.55,
   "text": "This is context rot."
  },
  {
   "start": 10.55,
   "end": 12.02,
   "text": "Notes, markdown files,"
  },
  {
   "start": 12.02,
   "end": 13.89,
   "text": "planning tools all rot too,"
  },
  {
   "start": 13.89,
   "end": 14.83,
   "text": "because a human has to"
  },
  {
   "start": 14.83,
   "end": 15.4,
   "text": "keep them current."
  },
  {
   "start": 16.07,
   "end": 17.42,
   "text": "So the plan says one thing"
  },
  {
   "start": 17.42,
   "end": 18.35,
   "text": "and the code says another."
  },
  {
   "start": 18.98,
   "end": 20.49,
   "text": "Dandy is the state layer."
  },
  {
   "start": 20.49,
   "end": 21.45,
   "text": "One place that knows"
  },
  {
   "start": 21.45,
   "end": 22.69,
   "text": "what your software is,"
  },
  {
   "start": 22.69,
   "end": 23.46,
   "text": "kept current by"
  },
  {
   "start": 23.46,
   "end": 24.79,
   "text": "the agents themselves."
  },
  {
   "start": 24.79,
   "end": 26.17,
   "text": "Your product is a graph"
  },
  {
   "start": 26.17,
   "end": 27.09,
   "text": "of projects"
  },
  {
   "start": 27.09,
   "end": 29.08,
   "text": "with typed inputs and outputs."
  },
  {
   "start": 29.08,
   "end": 30.51,
   "text": "Every agent reads it"
  },
  {
   "start": 30.51,
   "end": 31.18,
   "text": "before it starts"
  },
  {
   "start": 31.18,
   "end": 32.52,
   "text": "and writes back what it changed."
  },
  {
   "start": 33.33,
   "end": 34.56,
   "text": "Change something upstream,"
  },
  {
   "start": 34.56,
   "end": 36.33,
   "text": "and everything downstream knows."
  },
  {
   "start": 36.33,
   "end": 37.99,
   "text": "Next morning, new session."
  },
  {
   "start": 37.99,
   "end": 38.81,
   "text": "The agent picks up"
  },
  {
   "start": 38.81,
   "end": 39.84,
   "text": "exactly where it left off."
  },
  {
   "start": 40.54,
   "end": 41.76,
   "text": "Pick up where you left off."
  },
  {
   "start": 41.76,
   "end": 42.5,
   "text": "Every time."
  },
  {
   "start": 42.5,
   "end": 42.86,
   "text": "With Dandy."
  }
 ]
