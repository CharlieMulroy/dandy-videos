 "lines": [
  [
   1.04,
   2.54,
   "Think of your project as a city."
  ],
  [
   3.09,
   4.25,
   "Every part is a building,"
  ],
  [
   4.49,
   6.05,
   "wired to the parts it depends on."
  ],
  [
   6.69,
   7.48,
   "You ask your agent"
  ],
  [
   7.48,
   8.64,
   "for one small change."
  ],
  [
   8.84,
   9.87,
   "Rename a column."
  ],
  [
   9.97,
   11.11,
   "Done in ten seconds."
  ],
  [
   11.77,
   12.59,
   "What it didn't know:"
  ],
  [
   12.63,
   13.93,
   "three other parts of your project"
  ],
  [
   13.93,
   14.98,
   "were reading that column."
  ],
  [
   15.81,
   16.73,
   "Nothing errors."
  ],
  [
   16.97,
   18.34,
   "They just quietly go wrong,"
  ],
  [
   18.34,
   19.57,
   "and you find out next week."
  ],
  [
   20.19,
   21.75,
   "That's what propagation fixes."
  ],
  [
   22.2,
   23.96,
   "In Dandy, every piece of your project"
  ],
  [
   23.96,
   25.09,
   "says what it takes in"
  ],
  [
   25.09,
   26.19,
   "and what it puts out."
  ],
  [
   26.69,
   28.02,
   "So when one piece changes,"
  ],
  [
   28.27,
   29.77,
   "the change travels down the map."
  ],
  [
   30.76,
   32.04,
   "Everything that depends on it"
  ],
  [
   32.04,
   33.88,
   "gets updated or flagged,"
  ],
  [
   33.88,
   34.74,
   "and your agent is told"
  ],
  [
   34.74,
   36.2,
   "exactly what it just touched."
  ],
  [
   36.48,
   37.28,
   "One change."
  ],
  [
   37.64,
   38.9,
   "Nothing caught off guard."
  ]
 ],
