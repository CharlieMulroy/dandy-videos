 "lines": [
  [
   0.95,
   1.81,
   "Okay, follow along"
  ],
  [
   1.81,
   2.89,
   "while I explain our product"
  ],
  [
   2.89,
   4.25,
   "using a Thanksgiving metaphor."
  ],
  [
   4.44,
   5.99,
   "My cofounder did not approve this,"
  ],
  [
   5.99,
   7.32,
   "but I'm gonna do it anyway."
  ],
  [
   7.55,
   8.9,
   "So, the year 1621."
  ],
  [
   9.21,
   9.96,
   "The pilgrims are making"
  ],
  [
   9.96,
   11.59,
   "their first ever Thanksgiving dinner."
  ],
  [
   11.9,
   13.6,
   "The feast represents your project."
  ],
  [
   13.6,
   15.3,
   "The pilgrims are your AI agents."
  ],
  [
   15.3,
   16.48,
   "They're hard workers."
  ],
  [
   16.48,
   17.34,
   "Extremely fast."
  ],
  [
   17.5,
   18.41,
   "However, one problem is that"
  ],
  [
   18.41,
   19.65,
   "every morning they wake up"
  ],
  [
   19.65,
   20.69,
   "and forget everything."
  ],
  [
   21.14,
   22.1,
   "Who's catching the turkey?"
  ],
  [
   22.28,
   22.93,
   "Who's on corn?"
  ],
  [
   22.93,
   24.06,
   "What's already cooking?"
  ],
  [
   24.55,
   25.25,
   "So you end up with"
  ],
  [
   25.25,
   26.24,
   "three pots of corn,"
  ],
  [
   26.53,
   27.46,
   "you have no turkey,"
  ],
  [
   27.46,
   28.11,
   "and somebody moved"
  ],
  [
   28.11,
   29.03,
   "the feast up a day,"
  ],
  [
   29.32,
   30.85,
   "and nobody told the guy with the pie."
  ],
  [
   31.52,
   32.42,
   "Dandy's the scroll"
  ],
  [
   32.42,
   33.34,
   "that's nailed to the wall."
  ],
  [
   33.43,
   34.4,
   "It holds every dish,"
  ],
  [
   34.45,
   35.43,
   "who's on it, what it needs,"
  ],
  [
   35.59,
   36.26,
   "what's already done."
  ],
  [
   36.3,
   39.12,
   "Before they cook anything,"
  ],
  [
   39.12,
   40.3,
   "every pilgrim checks it."
  ],
  [
   40.3,
   42.13,
   "And after any task they finish,"
  ],
  [
   42.25,
   42.87,
   "they update it."
  ],
  [
   43.38,
   44.62,
   "So if the feast gets moved again,"
  ],
  [
   44.62,
   45.68,
   "they are all aware."
  ],
  [
   45.68,
   47.73,
   "And if you run out of any ingredient,"
  ],
  [
   47.73,
   49.05,
   "every dish that depends on it"
  ],
  [
   49.05,
   49.65,
   "gets flagged."
  ],
  [
   50.05,
   51.2,
   "It's the same pilgrims,"
  ],
  [
   51.29,
   52.72,
   "but the feast actually happens."
  ],
  [
   53.26,
   54.32,
   "Is this metaphor perfect?"
  ],
  [
   54.71,
   55.03,
   "No."
  ],
  [
   55.03,
   56.21,
   "But Happy Thanksgiving."
  ],
  [
   56.57,
   57.27,
   "Go try Dandy."
  ]
 ],
